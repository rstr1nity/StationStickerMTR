{
  "version": "2.0.0",
  "tasks": [
    {
      // Запускает игру на паузе; задача считается готовой, когда JVM открыла порт 5005 для отладчика
      "label": "runClient --debug-jvm",
      "type": "shell",
      "command": "./gradlew",
      "windows": { "command": ".\\gradlew.bat" },
      "args": ["runClient", "--debug-jvm"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "gradle",
        "pattern": { "regexp": "^\\b\\B$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^> Task :runClient",
          "endsPattern": "Listening for transport dt_socket at address"
        }
      }
    }
  ]
}
