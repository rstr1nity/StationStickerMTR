{
  "version": "2.0.0",
  "tasks": [
{
  "label": "Fabric: build jar for compatibility test",
  "type": "shell",
  "command": "./gradlew",
  "windows": {
    "command": ".\\gradlew.bat"
  },
  "args": [
    "build",
    "--console=plain"
  ],
  "options": {
    "cwd": "${workspaceFolder}/fabric"
  },
  "problemMatcher": []
},
{
  "label": "Fabric 1.20.4: compatibility test",
  "type": "shell",
  "command": "./gradlew",
  "windows": {
    "command": ".\\gradlew.bat"
  },
  "args": [
    "-p",
    "compat-1.20.4",
    "runClient",
    "--console=plain"
  ],
  "options": {
    "cwd": "${workspaceFolder}/fabric"
  },
  "dependsOn": "Fabric: build jar for compatibility test",
  "problemMatcher": []
},
{
  "label": "Fabric: automatic hot swap",
  "type": "shell",
  "command": "powershell.exe",
  "args": [
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-File",
    "${workspaceFolder}/fabric/tools/Start-HotSwap.ps1"
  ],
  "problemMatcher": []
},
    {
      // Запускает игру на паузе; задача считается готовой, когда JVM открыла порт 5005 для отладчика.
      // --console=plain: без прогресс-бара Gradle строка «Listening for transport» приходит целиком,
      // VS Code узнаёт её и сам подключает отладчик (иначе приходилось жать F5 ещё раз)
      "label": "runClient --debug-jvm",
      "type": "shell",
      "command": "./gradlew",
      "windows": { "command": ".\\gradlew.bat" },
      "args": ["runClient", "--debug-jvm", "--console=plain"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "gradle",
        "pattern": { "regexp": "^\\b\\B$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Task :runClient",
          "endsPattern": "Listening for transport dt_socket at address"
        }
      }
    }
  ]
}
